---
const { pillars, active } = Astro.props;
const items = ['All', ...pillars];
---

<div class="flex flex-wrap gap-2 text-sm">
  {items.map((pillar) => (
    <a
      href={pillar === 'All' ? '/blog' : `/blog?pillar=${encodeURIComponent(pillar)}`}
      class={`rounded-full border px-3 py-1 transition ${
        active === pillar
          ? 'border-ink text-ink'
          : 'border-border text-muted hover:text-ink'
      }`}
    >
      {pillar}
    </a>
  ))}
</div>
