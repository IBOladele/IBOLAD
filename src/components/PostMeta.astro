---
import { formatDate } from '@/utils/format';

const { date, updatedDate, readingMinutes, pillar } = Astro.props;
---

<div class="flex flex-wrap items-center gap-3 text-[0.7rem] uppercase tracking-[0.18em] text-muted">
  <span>{formatDate(date)}</span>
  {updatedDate ? <span>Updated {formatDate(updatedDate)}</span> : null}
  <span>{readingMinutes} min read</span>
  <span class="rounded-full border border-border px-2 py-0.5 text-[0.65rem] tracking-[0.12em]">
    {pillar}
  </span>
</div>
