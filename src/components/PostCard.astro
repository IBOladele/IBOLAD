---
import PostMeta from './PostMeta.astro';

const { post, readingMinutes } = Astro.props;
const { data, slug } = post;
---

<article class="surface-card flex flex-col gap-4">
  <PostMeta
    date={data.pubDate}
    updatedDate={data.updatedDate}
    readingMinutes={readingMinutes}
    pillar={data.pillar}
  />
  <div class="flex flex-col gap-2">
    <h3 class="text-xl font-semibold tracking-tightish">
      <a href={`/blog/${slug}`} class="text-ink">
        {data.title}
      </a>
    </h3>
    <p class="text-base text-muted">{data.description}</p>
  </div>
</article>
