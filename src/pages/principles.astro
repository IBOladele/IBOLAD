---
import Layout from '@/components/Layout.astro';
import { getCollection } from 'astro:content';
import { principles } from '@/data/principles';
import { sortPosts } from '@/utils/content';

const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
const postMap = new Map(posts.map((post) => [post.slug, post]));
---

<Layout title="Principles" description="A permanent index of the beliefs behind the work.">
  <section class="mx-auto w-full max-w-4xl px-6 py-14">
    <div class="space-y-4">
      <p class="text-xs uppercase tracking-[0.3em] text-muted">Foundations</p>
      <h1 class="text-3xl font-semibold tracking-tightish">Principles</h1>
      <p class="text-base text-muted">
        These are the durable ideas behind the writing. Each one is a lens for
        evaluating systems, incentives, and the long-term cost of short-term
        decisions.
      </p>
    </div>

    <div class="mt-10 space-y-6">
      {principles.map((principle) => {
        const relatedPosts = principle.related
          .map((slug) => postMap.get(slug))
          .filter(Boolean);

        return (
          <article class="surface-card space-y-4">
            <h2 class="text-xl font-semibold tracking-tightish">{principle.title}</h2>
            {principle.body.map((paragraph) => (
              <p class="text-sm text-muted">{paragraph}</p>
            ))}
            {relatedPosts.length ? (
              <div class="pt-2">
                <p class="text-xs uppercase tracking-[0.2em] text-muted">Related writing</p>
                <ul class="mt-3 space-y-2 text-sm text-muted">
                  {relatedPosts.map((post) => (
                    <li>
                      <a href={`/blog/${post.slug}`} class="hover:text-ink">
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null}
          </article>
        );
      })}
    </div>
  </section>
</Layout>
