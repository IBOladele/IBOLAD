---
import Layout from '@/components/Layout.astro';
import PillarFilter from '@/components/PillarFilter.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getActivePillar, getPillars, getReadingMinutes, sortPosts } from '@/utils/content';

const allPosts = sortPosts(
  await getCollection('blog', ({ data }) => {
    return !data.draft;
  })
);

const pillars = getPillars(allPosts);
const activePillar = getActivePillar(Astro.url.searchParams.get('pillar'), pillars);
const posts =
  activePillar === 'All'
    ? allPosts
    : allPosts.filter((post) => post.data.pillar === activePillar);
---

<Layout title="Blog" description="Essays on first principles, trust, and continuity.">
  <section class="mx-auto w-full max-w-5xl px-6 py-14">
    <div class="space-y-4">
      <p class="text-xs uppercase tracking-[0.3em] text-muted">Writing</p>
      <h1 class="text-3xl font-semibold tracking-tightish">Blog</h1>
      <p class="text-base text-muted">
        Notes on systems, incentives, and the edge cases that define reality.
      </p>
    </div>

    <div class="mt-8">
      <PillarFilter pillars={pillars} active={activePillar} />
    </div>

    <div class="mt-10 grid gap-6">
      {posts.length ? (
        posts.map((post) => (
          <PostCard post={post} readingMinutes={getReadingMinutes(post.body)} />
        ))
      ) : (
        <p class="text-sm text-muted">No posts yet for this pillar.</p>
      )}
    </div>
  </section>
</Layout>
