---
import Layout from '@/components/Layout.astro';
---

<Layout title="Not found" description="This page has moved or never existed.">
  <section class="mx-auto w-full max-w-4xl px-6 py-20">
    <div class="space-y-4">
      <p class="text-xs uppercase tracking-[0.3em] text-muted">404</p>
      <h1 class="text-3xl font-semibold tracking-tightish">Nothing here.</h1>
      <p class="text-base text-muted">
        The path does not resolve. If you expected something to be here, it may
        have been rewritten or removed.
      </p>
      <a class="text-sm text-muted hover:text-ink" href="/">
        Return to the notebook
      </a>
    </div>
  </section>
</Layout>
